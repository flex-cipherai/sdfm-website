# Google Tag Manager container ID (e.g. GTM-XXXXXXX).
# Set it in Netlify under Site configuration > Environment variables.
# When empty, events are still pushed to window.dataLayer but GTM is not loaded.
VITE_GTM_ID=

# URL that receives form submissions as JSON (custom builds, guide sign-up).
# When empty, forms show their success message but nothing is sent.
VITE_FORM_ENDPOINT=
